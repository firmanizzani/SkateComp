generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────

enum JenisKelamin {
  L
  P
}

enum StatusPendaftaran {
  Menunggu
  Terverifikasi
  Ditolak
}

enum StatusPembayaran {
  Menunggu
  Lunas
  Ditolak
}

enum Peringkat {
  Juara_1
  Juara_2
  Juara_3
}

// ─── MODELS ───────────────────────────────────────────────────

model Peserta {
  id_peserta    String       @id
  nama_peserta  String       @db.VarChar(100)
  tanggal_lahir DateTime     @db.Date
  jenis_kelamin JenisKelamin
  alamat        String?
  no_hp         String?      @db.VarChar(15)
  email         String       @unique @db.VarChar(100)
  nomor_bib     String?      @unique @db.VarChar(10)
  password      String

  pendaftaran Pendaftaran[]

  @@map("peserta")
}

model Juri {
  id_juri   String  @id
  nama_juri String  @db.VarChar(100)
  no_hp     String? @db.VarChar(15)
  email     String  @unique @db.VarChar(100)
  password  String

  penilaian Penilaian[]

  @@map("juri")
}

model Admin {
  id_admin   String @id
  nama_admin String @db.VarChar(100)
  email      String @unique @db.VarChar(100)
  password   String

  @@map("admin")
}

model JenisLomba {
  id_jenis_lomba    String  @id
  nama_lomba        String  @db.VarChar(50)
  biaya_pendaftaran Decimal @db.Decimal(10, 2)

  jadwal JadwalLomba[]

  @@map("jenis_lomba")
}

model KategoriLomba {
  id_kategori   String       @id
  nama_kategori String       @db.VarChar(50)
  jenis_kelamin JenisKelamin
  usia_min      Int          @db.SmallInt
  usia_maks     Int          @db.SmallInt

  jadwal JadwalLomba[]

  @@map("kategori_lomba")
}

model JadwalLomba {
  id_jadwal      String   @id
  id_jenis_lomba String
  id_kategori    String
  tanggal_lomba  DateTime @db.Date
  jam_mulai      String   @db.VarChar(8)
  jam_selesai    String   @db.VarChar(8)
  lokasi         String   @db.VarChar(100)

  jenisLomba  JenisLomba    @relation(fields: [id_jenis_lomba], references: [id_jenis_lomba])
  kategori    KategoriLomba @relation(fields: [id_kategori], references: [id_kategori])
  pendaftaran Pendaftaran[]
  pemenang    Pemenang[]

  @@map("jadwal_lomba")
}

model Pendaftaran {
  id_pendaftaran     String            @id
  id_peserta         String
  id_jadwal          String
  tanggal_daftar     DateTime          @db.Date
  status_pendaftaran StatusPendaftaran @default(Menunggu)

  peserta    Peserta      @relation(fields: [id_peserta], references: [id_peserta])
  jadwal     JadwalLomba  @relation(fields: [id_jadwal], references: [id_jadwal])
  pembayaran Pembayaran?
  penilaian  Penilaian[]
  pemenang   Pemenang?

  @@map("pendaftaran")
}

model Pembayaran {
  id_pembayaran      String           @id
  id_pendaftaran     String           @unique
  tanggal_pembayaran DateTime         @db.Date
  nominal            Decimal          @db.Decimal(10, 2)
  bukti_pembayaran   String?          @db.VarChar(255)
  status_pembayaran  StatusPembayaran @default(Menunggu)

  pendaftaran Pendaftaran @relation(fields: [id_pendaftaran], references: [id_pendaftaran])

  @@map("pembayaran")
}

model Penilaian {
  id_penilaian      String   @id
  id_pendaftaran    String
  id_juri           String
  aspek_1           Decimal? @db.Decimal(5, 2)
  aspek_2           Decimal? @db.Decimal(5, 2)
  aspek_3           Decimal? @db.Decimal(5, 2)
  nilai_akhir       Decimal? @db.Decimal(5, 2)
  catatan_penilaian String?

  pendaftaran Pendaftaran @relation(fields: [id_pendaftaran], references: [id_pendaftaran])
  juri        Juri        @relation(fields: [id_juri], references: [id_juri])

  @@map("penilaian")
}

model Pemenang {
  id_pemenang        String    @id
  id_jadwal          String
  id_pendaftaran     String    @unique
  peringkat          Peringkat
  tanggal_pengumuman DateTime  @db.Date

  jadwal      JadwalLomba @relation(fields: [id_jadwal], references: [id_jadwal])
  pendaftaran Pendaftaran @relation(fields: [id_pendaftaran], references: [id_pendaftaran])

  @@map("pemenang")
}

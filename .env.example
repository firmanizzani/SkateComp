# ================================================================
# SKATE COMPETITION BACKEND - Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# ================================================================

# ─── DATABASE ──────────────────────────────────────────────────
# Dapatkan dari: Supabase Dashboard → Settings → Database → Connection String → URI
# PENTING: Ganti [YOUR-PASSWORD] dan [YOUR-PROJECT-REF] sesuai project Supabase Anda
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?schema=public"

# ─── JWT AUTH ──────────────────────────────────────────────────
# Ganti dengan random string yang panjang (min. 32 karakter) untuk keamanan
JWT_SECRET="ganti-dengan-string-random-yang-sangat-panjang-dan-aman-di-production"
JWT_EXPIRES_IN="7d"

# ─── SERVER ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS - Frontend URL ───────────────────────────────────────
# URL frontend React Anda (saat development)
FRONTEND_URL="http://localhost:5173"
